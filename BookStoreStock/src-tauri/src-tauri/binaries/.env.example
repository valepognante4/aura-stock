# ─────────────────────────────────────────────────────────────────────────────
# .env de producción — AuraStock Backend (sidecar)
# ─────────────────────────────────────────────────────────────────────────────
# Coloca este archivo en la misma carpeta que aurastock-backend.exe
# (o en la carpeta de instalación de la app).
#
# Si las variables de entorno del sistema ya están definidas, tienen PRIORIDAD
# sobre los valores de este archivo (override=False en run_server.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos Oracle ──────────────────────────────────────────────────────
# Formato thin mode (no requiere Oracle Client instalado):
#   oracle+oracledb://USUARIO:CLAVE@HOST:PUERTO/?service_name=SERVICIO
DATABASE_URL=oracle+oracledb://system:ides@localhost:1521/?service_name=XEPDB1

# ── SMTP (para envío de correos: recuperación de contraseña, etc.) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion

# ── URLs ──────────────────────────────────────────────────────────────────────
# En producción (Tauri), el frontend corre dentro del WebView de Tauri.
# Agregar "tauri://localhost" permite las peticiones CORS del WebView.
FRONTEND_URL=tauri://localhost
CORS_ORIGINS=tauri://localhost,http://localhost:4200
