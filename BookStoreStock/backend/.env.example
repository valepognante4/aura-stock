# ─────────────────────────────────────────────────────────────────────────────
# EJEMPLO DE VARIABLES DE ENTORNO — AuraStock Backend
# ─────────────────────────────────────────────────────────────────────────────
# 
# Renombra este archivo a `.env` y completa con tus credenciales reales.
# NUNCA subas el archivo `.env` a un repositorio público.
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Tu dirección de Gmail (la que enviará los correos)
SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación generada en tu cuenta de Google (16 caracteres, sin espacios)
SMTP_PASSWORD=tu_contraseña_de_aplicacion

# URL del frontend (generalmente localhost:4200 en desarrollo)
FRONTEND_URL=http://localhost:4200
